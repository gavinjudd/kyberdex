# Reference only: KyberDex does not load .env files automatically.
# Export settings in your shell, or use the protected systemd service.env file.
# Leave blank for offline checks; set your own server ID before running Discord.
VAULT_GUILD_ID=
# Optional channel IDs to count for activity-based encounter timing.
VAULT_ACTIVITY_CHANNEL_IDS=
# Set to the absolute mode 0600 file created by deploy/provision-token.py.
DISCORD_TOKEN_FILE=
# Used only by provision-token.py to verify the expected bot identity.
DISCORD_APPLICATION_ID=
VAULT_SPAWN_INTERVAL=900
VAULT_DROP_DURATION=180
VAULT_ENABLED_EVENTS=
VAULT_ENABLED_RELEASES=
VAULT_PUBLIC_URL=
# Optional absolute path overrides; omit to use the checkout and state/vault.sqlite3.
# VAULT_ROOT=/absolute/path/to/kyberdex
# VAULT_DATABASE=/absolute/path/to/kyberdex/state/vault.sqlite3
# Optional SSH snapshot destination (configure your own SSH host alias).
# VAULT_REPLICA_HOST=kyberdex-host
# VAULT_REPLICA_ROOT=/absolute/path/to/kyberdex
